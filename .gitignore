.vercel

# PNGs dos slides: gerados por social/render/render.py a partir de all-slides.html
social/instagram-launch/*/slides-png/

# Originais pesados que os grupos nos mandam. O que vai para o site é a versão
# otimizada em app/assets/, gerada por build/otimizar_pdf_anexo.py.
/Oficinas de Oração e Vida *.pdf

# Estado local da CLI do Supabase (projeto ligado, versões, URL do pooler).
# É por máquina, não por repositório.
supabase/.temp/

# Worktrees isolados de execução de planos (superpowers), scratch local.
.worktrees/

# Bytecode do Python (build_pdf_abnt.py, fix_textual.py e afins).
__pycache__/
*.pyc
.pytest_cache/

# Fontes legais primarias baixadas para consulta (vade mecum, CF/88, ECA,
# LOAS...). ~40 MB, regeneraveis a partir das fontes oficiais. Consultadas
# pelas skills, nunca editadas pelo projeto.
biblioteca/

# PDFs gerados por build_pdf_abnt.py. Artefato de build, nao fonte.
Manual_Vicentino_ABNT.pdf
Manual_Vicentino_ABNT_v3.pdf
Manual_Vicentino_ABNT_v3.tex
Manual_Vicentino_Completo.pdf

# Fotos originais (paroquia, almoco, capturas de tela). O que vai para o site
# e a versao otimizada em app/assets/.
*.jpg
*.jpeg
